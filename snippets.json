  "DSU with Rollback": {
    "prefix": "DSUR",
    "body": [
      "struct DSU {",
      "    vi parent, rank_;",
      "    vector<pair<int*,int>> history;",
      "",
      "    DSU(int n) : parent(n+1), rank_(n+1, 0) { iota(all(parent), 0); }",
      "",
      "    int find(int x) {",
      "        while (parent[x] != x) x = parent[x]; // no path compression",
      "        return x;",
      "    }",
      "",
      "    bool unite(int u, int v) {",
      "        u = find(u); v = find(v);",
      "        if (u == v) return false;",
      "        if (rank_[u] < rank_[v]) swap(u, v);",
      "        history.push_back({&parent[v], parent[v]});",
      "        history.push_back({&rank_[u],  rank_[u]});",
      "        parent[v] = u;",
      "        if (rank_[u] == rank_[v]) rank_[u]++;",
      "        return true;",
      "    }",
      "",
      "    bool same(int u, int v) { return find(u) == find(v); }",
      "",
      "    int checkpoint() { return history.size(); }",
      "",
      "    void rollback(int cp) {",
      "        while ((int)history.size() > cp) {",
      "            *history.back().first = history.back().second;",
      "            history.pop_back();",
      "        }",
      "    }",
      "};"
    ],
    "description": "DSU with Rollback (union by rank only, no path compression)"
  },
  "Mint": {
