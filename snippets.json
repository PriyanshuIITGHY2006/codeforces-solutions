      "vi spf(MAXN);",
      "void spf_sieve() {",
      "    iota(all(spf), 0);",
      "    for (int i = 2; (ll)i*i < MAXN; i++)",
      "        if (spf[i] == i) // i is prime",
      "            for (int j = i*i; j < MAXN; j += i)",
      "                if (spf[j] == j) spf[j] = i;",
      "}",
      "map<int,int> factorize(int n) {",
      "    map<int,int> f;",
      "    while (n > 1) { f[spf[n]]++; n /= spf[n]; }",
