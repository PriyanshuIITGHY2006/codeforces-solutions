  "LucasTheorem": {
    "prefix": "lucas",
    "body": [
      "// C(n, r) mod p using Lucas' theorem (p must be prime)",
      "ll lucas(ll n, ll r, ll p) {",
      "    if (r == 0) return 1;",
      "    if (r > n) return 0;",
      "    // small C(n%p, r%p) * lucas(n/p, r/p)",
      "    // precompute fact mod p for small values",
      "    vector<ll> f(p);",
      "    f[0] = 1;",
      "    for (int i = 1; i < p; i++) f[i] = f[i-1] * i % p;",
      "    function<ll(ll,ll)> C = [&](ll n, ll r) -> ll {",
      "        if (r == 0) return 1;",
      "        if (r > n) return 0;",
      "        ll ni = n % p, ri = r % p;",
      "        if (ri > ni) return 0;",
      "        ll cur = f[ni] % p * binpow(f[ri] * f[ni-ri] % p, p-2, p) % p;",
      "        return cur * C(n/p, r/p) % p;",
      "    };",
      "    return C(n, r);",
      "}"
    ],
    "description": "Lucas' Theorem for C(n,r) mod prime p"
  },
  "GaussianElimination": {
    "prefix": "gauss",
    "body": [
      "// Gaussian elimination over doubles",
      "// Returns rank; modifies a in-place, solution in x",
      "const ld EPS = 1e-9;",
      "int gauss(vector<vector<ld>>& a, vector<ld>& x) {",
      "    int n = a.size(), m = a[0].size() - 1;",
      "    vi pivot_row(m, -1);",
      "    int rank = 0;",
      "    for (int col = 0, row = 0; col < m && row < n; col++) {",
      "        int sel = row;",
      "        for (int i = row; i < n; i++)",
      "            if (fabsl(a[i][col]) > fabsl(a[sel][col])) sel = i;",
      "        if (fabsl(a[sel][col]) < EPS) continue;",
      "        swap(a[sel], a[row]);",
      "        pivot_row[col] = row;",
      "        ld inv = 1.0L / a[row][col];",
      "        for (int j = col; j <= m; j++) a[row][j] *= inv;",
      "        for (int i = 0; i < n; i++) {",
      "            if (i == row || fabsl(a[i][col]) < EPS) continue;",
      "            ld c = a[i][col];",
      "            for (int j = col; j <= m; j++) a[i][j] -= c * a[row][j];",
      "        }",
      "        row++; rank++;",
      "    }",
      "    x.assign(m, 0);",
      "    for (int col = 0; col < m; col++)",
      "        if (pivot_row[col] != -1)",
      "            x[col] = a[pivot_row[col]][m];",
      "    return rank;",
      "}"
    ],
    "description": "Gaussian Elimination (real-valued)"
  },
  "XorBasis": {
    "prefix": "xorbasis",
    "body": [
      "// Linear basis over GF(2) — max XOR, check XOR reachability",
      "struct XorBasis {",
      "    vll b;",
      "    bool insert(ll x) {",
      "        for (ll v : b) x = min(x, x ^ v);",
      "        if (!x) return false; // x already in span",
      "        b.push_back(x);",
      "        for (int i = b.size()-1; i > 0 && b[i] > b[i-1]; i--)",
      "            swap(b[i], b[i-1]);",
      "        return true;",
      "    }",
      "    ll max_xor(ll x = 0) {",
      "        for (ll v : b) x = max(x, x ^ v);",
      "        return x;",
      "    }",
      "    bool can_reach(ll x) {",
      "        for (ll v : b) x = min(x, x ^ v);",
      "        return x == 0;",
      "    }",
      "};"
    ],
