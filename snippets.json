  "Difference2D": {
    "prefix": "diffarray2d",
    "body": [
      "// 2D Difference Array — O(1) rectangle update, O(nm) rebuild",
      "// Add val to all cells (r1,c1)..(r2,c2) (1-indexed)",
      "vector<vll> diff(n + 2, vll(m + 2, 0));",
      "",
      "auto rect_add = [&](int r1, int c1, int r2, int c2, ll val) {",
      "    diff[r1][c1]     += val;",
      "    diff[r1][c2+1]   -= val;",
      "    diff[r2+1][c1]   -= val;",
      "    diff[r2+1][c2+1] += val;",
      "};",
      "",
      "// Rebuild prefix sums to get final grid values",
      "for (int i = 1; i <= n; i++)",
      "    for (int j = 1; j <= m; j++)",
      "        diff[i][j] += diff[i-1][j] + diff[i][j-1] - diff[i-1][j-1];"
    ],
    "description": "2D Difference Array (rectangle range add)"
  },
  "FenwickRangeUpdateRangeQuery": {
    "prefix": "fenwickrurq",
    "body": [
      "// Fenwick Tree: range add, range sum query",
      "// Uses two BITs. add(l,r,v): adds v to [l..r]. query(l,r): sum of [l..r]",
      "struct FenwickRURQ {",
      "    int n; vll b1, b2;",
      "    FenwickRURQ(int n) : n(n), b1(n+2,0), b2(n+2,0) {}",
      "    void _add(vll& b, int i, ll v) { for (; i <= n; i += i&-i) b[i] += v; }",
      "    ll _sum(vll& b, int i) { ll s=0; for (; i > 0; i -= i&-i) s += b[i]; return s; }",
      "    void add(int l, int r, ll v) {",
      "        _add(b1, l, v);       _add(b1, r+1, -v);",
      "        _add(b2, l, v*(l-1)); _add(b2, r+1, -v*r);",
      "    }",
      "    ll prefix(int i) { return _sum(b1,i)*i - _sum(b2,i); }",
      "    ll query(int l, int r) { return prefix(r) - prefix(l-1); }",
      "};"
    ],
    "description": "Fenwick Tree: range add, range sum query"
  },
  "SegTreeBeats": {
    "prefix": "segtreebeats",
    "body": [
      "// Segment Tree Beats (Ji Driver Segmentation)",
      "// Supports: range chmin, range sum query",
      "struct SegTreeBeats {",
      "    struct Node {",
      "        ll sum, mx, mx2; int cnt_mx;",
      "        ll lazy_add, lazy_chmin;",
      "        Node() : sum(0), mx(-INF), mx2(-INF), cnt_mx(0),",
      "                 lazy_add(0), lazy_chmin(INF) {}",
      "    };",
      "    int n; vector<Node> t;",
      "    SegTreeBeats(int n) : n(n), t(4*n) {}",
      "    void push_up(int v) {",
      "        t[v].sum = t[2*v].sum + t[2*v+1].sum;",
      "        if (t[2*v].mx == t[2*v+1].mx) {",
      "            t[v].mx = t[2*v].mx;",
      "            t[v].cnt_mx = t[2*v].cnt_mx + t[2*v+1].cnt_mx;",
      "            t[v].mx2 = max(t[2*v].mx2, t[2*v+1].mx2);",
      "        } else if (t[2*v].mx > t[2*v+1].mx) {",
      "            t[v].mx = t[2*v].mx; t[v].cnt_mx = t[2*v].cnt_mx;",
      "            t[v].mx2 = max(t[2*v].mx2, t[2*v+1].mx);",
      "        } else {",
      "            t[v].mx = t[2*v+1].mx; t[v].cnt_mx = t[2*v+1].cnt_mx;",
      "            t[v].mx2 = max(t[2*v].mx, t[2*v+1].mx2);",
      "        }",
      "    }",
      "    void apply_chmin(int v, ll val) {",
      "        if (val >= t[v].mx) return;",
      "        t[v].sum -= (ll)(t[v].mx - val) * t[v].cnt_mx;",
      "        t[v].mx = t[v].lazy_chmin = val;",
      "    }",
      "    void apply_add(int v, ll val, int sz) {",
      "        t[v].sum += val * sz;",
      "        t[v].mx += val; if (t[v].mx2 != -INF) t[v].mx2 += val;",
      "        t[v].lazy_add += val;",
      "    }",
      "    void push_down(int v, int l, int r) {",
      "        int mid = (l+r)/2;",
      "        if (t[v].lazy_add) {",
      "            apply_add(2*v, t[v].lazy_add, mid-l+1);",
      "            apply_add(2*v+1, t[v].lazy_add, r-mid);",
      "            t[v].lazy_add = 0;",
      "        }",
      "        if (t[v].lazy_chmin < INF) {",
      "            apply_chmin(2*v, t[v].lazy_chmin);",
      "            apply_chmin(2*v+1, t[v].lazy_chmin);",
      "            t[v].lazy_chmin = INF;",
      "        }",
      "    }",
      "    void build(vll& a, int v, int l, int r) {",
      "        if (l == r) {",
      "            t[v].sum = t[v].mx = a[l]; t[v].cnt_mx = 1; t[v].mx2 = -INF;",
      "            return;",
      "        }",
      "        int mid = (l+r)/2;",
      "        build(a, 2*v, l, mid); build(a, 2*v+1, mid+1, r);",
      "        push_up(v);",
      "    }",
      "    void update_chmin(int v, int l, int r, int ql, int qr, ll val) {",
      "        if (qr < l || r < ql || t[v].mx <= val) return;",
      "        if (ql <= l && r <= qr && t[v].mx2 < val) { apply_chmin(v, val); return; }",
      "        push_down(v, l, r); int mid = (l+r)/2;",
      "        update_chmin(2*v, l, mid, ql, qr, val);",
      "        update_chmin(2*v+1, mid+1, r, ql, qr, val);",
      "        push_up(v);",
      "    }",
      "    ll query_sum(int v, int l, int r, int ql, int qr) {",
      "        if (qr < l || r < ql) return 0;",
      "        if (ql <= l && r <= qr) return t[v].sum;",
      "        push_down(v, l, r); int mid = (l+r)/2;",
      "        return query_sum(2*v, l, mid, ql, qr) + query_sum(2*v+1, mid+1, r, ql, qr);",
      "    }",
      "    void build(vll& a) { build(a, 1, 0, n-1); }",
      "    void chmin(int l, int r, ll v) { update_chmin(1, 0, n-1, l, r, v); }",
      "    ll sum(int l, int r) { return query_sum(1, 0, n-1, l, r); }",
      "};"
    ],
    "description": "Segment Tree Beats (range chmin, range sum)"
  },
  "SqrtDecomposition": {
    "prefix": "sqrtdec",
    "body": [
      "// Sqrt decomposition: O(sqrt n) per query/update",
      "int BLOCK = sqrt(n) + 1;",
      "int num_blocks = (n + BLOCK - 1) / BLOCK;",
      "vll block(num_blocks, 0);",
      "",
      "// Build blocks (prefix sums per block)",
      "for (int i = 0; i < n; i++) block[i / BLOCK] += a[i];",
      "",
      "// Range sum query [l, r]",
      "auto query = [&](int l, int r) -> ll {",
      "    ll res = 0;",
      "    int bl = l / BLOCK, br = r / BLOCK;",
      "    if (bl == br) {",
      "        for (int i = l; i <= r; i++) res += a[i];",
      "    } else {",
      "        for (int i = l; i < (bl+1)*BLOCK; i++) res += a[i];",
      "        for (int b = bl+1; b < br; b++) res += block[b];",
      "        for (int i = br*BLOCK; i <= r; i++) res += a[i];",
      "    }",
      "    return res;",
      "};",
      "",
      "// Point update at position i",
      "auto update = [&](int i, ll val) {",
      "    block[i / BLOCK] += val - a[i];",
      "    a[i] = val;",
      "};"
    ],
    "description": "Sqrt Decomposition (range sum, point update)"
  },
  "MoAlgorithm": {
    "prefix": "mo",
    "body": [
      "// Mo's Algorithm: offline range queries in O((n + q) * sqrt(n))",
      "int BLOCK = max(1, (int)sqrt(n));",
      "struct Query { int l, r, idx; };",
      "vector<Query> queries(q);",
      "for (int i = 0; i < q; i++) {",
      "    cin >> queries[i].l >> queries[i].r;",
      "    queries[i].l--; queries[i].r--; // 0-indexed",
      "    queries[i].idx = i;",
      "}",
      "sort(all(queries), [&](const Query& a, const Query& b) {",
      "    int ba = a.l / BLOCK, bb = b.l / BLOCK;",
      "    if (ba != bb) return ba < bb;",
      "    return (ba & 1) ? a.r > b.r : a.r < b.r; // alternating for speed",
      "});",
      "",
      "vll ans(q);",
      "int curl = 0, curr = -1;",
      "ll cur_ans = 0;",
      "",
      "auto add = [&](int pos) { /* add a[pos] to current window */ };",
      "auto rem = [&](int pos) { /* remove a[pos] from current window */ };",
      "",
      "for (auto& [l, r, idx] : queries) {",
      "    while (curr < r) add(++curr);",
      "    while (curl > l) add(--curl);",
      "    while (curr > r) rem(curr--);",
      "    while (curl < l) rem(curl++);",
      "    ans[idx] = cur_ans;",
      "}"
    ],
    "description": "Mo's Algorithm (offline range queries)"
  },
  // ═══════════════════════════════════════════════════
  //  GRAPH ALGORITHMS (additions)
  // ═══════════════════════════════════════════════════
  "HLD": {
    "prefix": "hld",
    "body": [
      "// Heavy-Light Decomposition",
      "// Supports: path queries/updates on tree edges or nodes",
      "struct HLD {",
      "    int n, timer = 0;",
      "    vi parent, depth, heavy, head, pos, sz;",
      "    vector<vi>& adj;",
      "",
      "    HLD(int n, vector<vi>& adj) : n(n), adj(adj),",
      "        parent(n+1), depth(n+1), heavy(n+1,-1),",
      "        head(n+1), pos(n+1), sz(n+1) {}",
      "",
      "    int dfs(int u, int p, int d) {",
      "        parent[u] = p; depth[u] = d; sz[u] = 1;",
      "        int max_sz = 0;",
      "        for (int v : adj[u]) {",
      "            if (v == p) continue;",
      "            sz[u] += dfs(v, u, d+1);",
      "            if (sz[v] > max_sz) { max_sz = sz[v]; heavy[u] = v; }",
      "        }",
      "        return sz[u];",
      "    }",
      "",
      "    void decompose(int u, int h) {",
      "        head[u] = h; pos[u] = timer++;",
      "        if (heavy[u] != -1) decompose(heavy[u], h);",
      "        for (int v : adj[u])",
      "            if (v != parent[u] && v != heavy[u]) decompose(v, v);",
      "    }",
      "",
      "    void build(int root = 1) { dfs(root, 0, 0); decompose(root, root); }",
      "",
      "    // Query on path u -> v (node values)",
      "    // Replace with your seg tree query",
      "    ll path_query(int u, int v) {",
      "        ll res = 0;",
      "        while (head[u] != head[v]) {",
      "            if (depth[head[u]] < depth[head[v]]) swap(u, v);",
      "            res += seg.query(pos[head[u]], pos[u]); // your seg tree",
      "            u = parent[head[u]];",
      "        }",
      "        if (depth[u] > depth[v]) swap(u, v);",
      "        res += seg.query(pos[u], pos[v]);",
      "        return res;",
      "    }",
      "",
      "    void path_update(int u, int v, ll val) {",
      "        while (head[u] != head[v]) {",
      "            if (depth[head[u]] < depth[head[v]]) swap(u, v);",
      "            seg.update(pos[head[u]], pos[u], val);",
      "            u = parent[head[u]];",
      "        }",
      "        if (depth[u] > depth[v]) swap(u, v);",
      "        seg.update(pos[u], pos[v], val);",
      "    }",
      "};"
    ],
    "description": "Heavy-Light Decomposition"
  },
  "CentroidDecomposition": {
    "prefix": "centroid",
    "body": [
      "// Centroid Decomposition",
      "vi sz(n+1), removed(n+1, 0), centroid_parent(n+1, -1);",
      "",
      "function<int(int,int)> get_sz = [&](int u, int p) -> int {",
      "    sz[u] = 1;",
      "    for (int v : adj[u]) if (v != p && !removed[v]) sz[u] += get_sz(v, u);",
      "    return sz[u];",
      "};",
      "",
      "function<int(int,int)> get_centroid = [&](int u, int p, int tree_sz) -> int {",
      "    for (int v : adj[u]) {",
      "        if (v != p && !removed[v] && sz[v] > tree_sz / 2)",
      "            return get_centroid(v, u, tree_sz);",
      "    }",
      "    return u;",
      "};",
      "",
      "function<void(int,int)> build = [&](int u, int par) {",
      "    int tree_sz = get_sz(u, -1);",
      "    int c = get_centroid(u, -1, tree_sz);",
      "    centroid_parent[c] = par;",
      "    removed[c] = 1;",
      "    // process centroid c: collect distances from c to all nodes in component",
      "    for (int v : adj[c]) if (!removed[v]) build(v, c);",
      "};",
      "build(1, -1);"
    ],
    "description": "Centroid Decomposition"
  },
  "TwoSAT": {
    "prefix": "twosat",
    "body": [
      "// 2-SAT: variables x_0..x_{n-1}",
      "// Node i = x_i true, node i+n = x_i false",
      "struct TwoSAT {",
      "    int n;",
      "    vector<vi> adj, radj;",
      "    vi order, comp;",
      "    vector<bool> visited;",
      "",
      "    TwoSAT(int n) : n(n), adj(2*n), radj(2*n), comp(2*n,-1), visited(2*n,false) {}",
      "",
      "    // Add clause (x_u = val_u) OR (x_v = val_v)",
      "    void add_clause(int u, bool val_u, int v, bool val_v) {",
      "        // if NOT(u=val_u) then (v=val_v)",
      "        adj[u + (val_u ? n : 0)].push_back(v + (val_v ? 0 : n));",
      "        adj[v + (val_v ? n : 0)].push_back(u + (val_u ? 0 : n));",
      "        // reverse",
      "        radj[v + (val_v ? 0 : n)].push_back(u + (val_u ? n : 0));",
      "        radj[u + (val_u ? 0 : n)].push_back(v + (val_v ? n : 0));",
      "    }",
      "",
      "    function<void(int)> dfs1 = [&](int u) {",
      "        visited[u] = true;",
      "        for (int v : adj[u]) if (!visited[v]) dfs1(v);",
      "        order.push_back(u);",
      "    };",
      "    function<void(int,int)> dfs2 = [&](int u, int c) {",
      "        comp[u] = c;",
      "        for (int v : radj[u]) if (comp[v] == -1) dfs2(v, c);",
      "    };",
      "",
      "    // Returns true if satisfiable; assigns values to vars",
      "    bool solve(vector<bool>& vals) {",
      "        for (int i = 0; i < 2*n; i++) if (!visited[i]) dfs1(i);",
      "        int c = 0;",
      "        for (int i = 2*n-1; i >= 0; i--)",
      "            if (comp[order[i]] == -1) dfs2(order[i], c++);",
      "        vals.resize(n);",
      "        for (int i = 0; i < n; i++) {",
      "            if (comp[i] == comp[i+n]) return false; // contradiction",
      "            vals[i] = comp[i] > comp[i+n];",
      "        }",
      "        return true;",
      "    }",
      "};"
    ],
    "description": "2-SAT (Kosaraju SCC)"
  },
  "DinicsMaxFlow": {
    "prefix": "dinic",
    "body": [
      "// Dinic's Maximum Flow — O(V^2 * E), O(E * sqrt(V)) for unit graphs",
      "struct Dinic {",
      "    struct Edge { int to, rev; ll cap; };",
      "    int n; vector<vector<Edge>> g; vi level, iter;",
      "",
      "    Dinic(int n) : n(n), g(n), level(n), iter(n) {}",
      "",
      "    void add_edge(int u, int v, ll cap, bool directed = true) {",
      "        g[u].push_back({v, (int)g[v].size(), cap});",
      "        g[v].push_back({u, (int)g[u].size()-1, directed ? 0 : cap});",
      "    }",
      "",
      "    bool bfs(int s, int t) {",
      "        fill(all(level), -1);",
      "        queue<int> q;",
      "        level[s] = 0; q.push(s);",
      "        while (!q.empty()) {",
      "            int u = q.front(); q.pop();",
      "            for (auto& e : g[u])",
      "                if (e.cap > 0 && level[e.to] < 0) {",
      "                    level[e.to] = level[u] + 1; q.push(e.to);",
      "                }",
      "        }",
      "        return level[t] >= 0;",
      "    }",
      "",
      "    ll dfs(int u, int t, ll f) {",
      "        if (u == t) return f;",
      "        for (int& i = iter[u]; i < (int)g[u].size(); i++) {",
      "            Edge& e = g[u][i];",
      "            if (e.cap > 0 && level[u] < level[e.to]) {",
      "                ll d = dfs(e.to, t, min(f, e.cap));",
      "                if (d > 0) { e.cap -= d; g[e.to][e.rev].cap += d; return d; }",
      "            }",
      "        }",
      "        return 0;",
      "    }",
      "",
      "    ll max_flow(int s, int t) {",
      "        ll flow = 0;",
      "        while (bfs(s, t)) {",
      "            fill(all(iter), 0);",
      "            ll f;",
      "            while ((f = dfs(s, t, INF)) > 0) flow += f;",
      "        }",
      "        return flow;",
      "    }",
      "};"
    ],
    "description": "Dinic's Maximum Flow"
  },
  "HopcroftKarp": {
    "prefix": "hopcroft",
    "body": [
      "// Hopcroft-Karp Bipartite Matching — O(E * sqrt(V))",
      "// Left nodes: 1..l, Right nodes: 1..r",
      "struct HopcroftKarp {",
      "    int l, r;",
      "    vector<vi> adj; // adj[left_node] = list of right nodes",
      "    vi matchL, matchR, dist;",
      "",
      "    HopcroftKarp(int l, int r) : l(l), r(r), adj(l+1), matchL(l+1,0), matchR(r+1,0), dist(l+1) {}",
      "",
      "    void add_edge(int u, int v) { adj[u].push_back(v); }",
      "",
      "    bool bfs() {",
      "        queue<int> q;",
      "        for (int u = 1; u <= l; u++) {",
      "            if (!matchL[u]) { dist[u] = 0; q.push(u); }",
      "            else dist[u] = INF;",
      "        }",
      "        bool found = false;",
      "        while (!q.empty()) {",
      "            int u = q.front(); q.pop();",
      "            for (int v : adj[u]) {",
      "                int w = matchR[v];",
      "                if (!w) found = true;",
      "                else if (dist[w] == INF) { dist[w] = dist[u]+1; q.push(w); }",
      "            }",
      "        }",
      "        return found;",
      "    }",
      "",
      "    bool dfs(int u) {",
      "        for (int v : adj[u]) {",
      "            int w = matchR[v];",
      "            if (!w || (dist[w] == dist[u]+1 && dfs(w))) {",
      "                matchL[u] = v; matchR[v] = u; return true;",
      "            }",
      "        }",
      "        dist[u] = INF; return false;",
      "    }",
      "",
      "    int max_matching() {",
      "        int res = 0;",
      "        while (bfs()) for (int u = 1; u <= l; u++) if (!matchL[u] && dfs(u)) res++;",
      "        return res;",
      "    }",
      "};"
    ],
    "description": "Hopcroft-Karp Bipartite Matching"
  },
  "SmallToLarge": {
    "prefix": "smalltolarge",
    "body": [
      "// Small-to-Large (DSU on tree) merging",
      "// Each node u has a set. Merge children into u greedily.",
      "vector<set<int>> st(n+1);",
      "// Initialize: st[u].insert(value[u]);",
      "",
      "function<void(int,int)> dfs = [&](int u, int p) {",
      "    for (int v : adj[u]) {",
      "        if (v == p) continue;",
      "        dfs(v, u);",
      "        // merge smaller into larger",
      "        if (st[u].size() < st[v].size()) swap(st[u], st[v]);",
      "        for (int x : st[v]) st[u].insert(x);",
      "        st[v].clear();",
      "    }",
      "    // process st[u] — contains all values in subtree of u",
      "};"
    ],
    "description": "Small-to-Large (set merging on tree)"
  },
  "MinCostFlow": {
    "prefix": "mcmf",
    "body": [
      "// Min Cost Max Flow (SPFA / Bellman-Ford based)",
      "struct MCMF {",
      "    struct Edge { int to, rev; ll cap, cost; };",
      "    int n; vector<vector<Edge>> g;",
      "    MCMF(int n) : n(n), g(n) {}",
      "    void add_edge(int u, int v, ll cap, ll cost) {",
      "        g[u].push_back({v, (int)g[v].size(), cap, cost});",
      "        g[v].push_back({u, (int)g[u].size()-1, 0, -cost});",
      "    }",
      "    pair<ll,ll> min_cost_flow(int s, int t, ll max_flow = INF) {",
      "        ll flow = 0, cost = 0;",
      "        while (flow < max_flow) {",
      "            vll dist(n, INF); vector<bool> in_q(n, false);",
      "            vector<int> prev_v(n,-1), prev_e(n,-1);",
      "            dist[s] = 0;",
      "            queue<int> q; q.push(s); in_q[s] = true;",
      "            while (!q.empty()) {",
      "                int u = q.front(); q.pop(); in_q[u] = false;",
      "                for (int i = 0; i < (int)g[u].size(); i++) {",
      "                    auto& e = g[u][i];",
      "                    if (e.cap > 0 && dist[u] + e.cost < dist[e.to]) {",
      "                        dist[e.to] = dist[u] + e.cost;",
      "                        prev_v[e.to] = u; prev_e[e.to] = i;",
      "                        if (!in_q[e.to]) { q.push(e.to); in_q[e.to] = true; }",
      "                    }",
      "                }",
      "            }",
      "            if (dist[t] == INF) break;",
      "            ll d = max_flow - flow;",
      "            for (int v = t; v != s; v = prev_v[v])",
      "                d = min(d, g[prev_v[v]][prev_e[v]].cap);",
      "            for (int v = t; v != s; v = prev_v[v]) {",
      "                auto& e = g[prev_v[v]][prev_e[v]];",
      "                e.cap -= d; g[v][e.rev].cap += d;",
      "            }",
      "            flow += d; cost += d * dist[t];",
      "        }",
      "        return {flow, cost};",
      "    }",
      "};"
    ],
    "description": "Min Cost Max Flow (SPFA)"
  },
  // ═══════════════════════════════════════════════════
  //  STRING ALGORITHMS (additions)
  // ═══════════════════════════════════════════════════
  "SuffixArray": {
    "prefix": "suffixarray",
    "body": [
      "// Suffix Array — O(n log n) construction",
      "// sa[i] = starting index of i-th lexicographically smallest suffix",
      "// lcp[i] = LCP of sa[i-1] and sa[i] (Kasai's algorithm)",
      "struct SuffixArray {",
      "    int n;",
      "    vi sa, rank_, lcp;",
      "",
      "    SuffixArray(const string& s) : n(s.size()), sa(n), rank_(n), lcp(n) {",
      "        iota(all(sa), 0);",
      "        rank_.assign(s.begin(), s.end());",
      "        vi tmp(n);",
      "        for (int k = 1; k < n; k <<= 1) {",
      "            auto cmp = [&](int a, int b) {",
      "                if (rank_[a] != rank_[b]) return rank_[a] < rank_[b];",
      "                int ra = a+k < n ? rank_[a+k] : -1;",
      "                int rb = b+k < n ? rank_[b+k] : -1;",
      "                return ra < rb;",
      "            };",
      "            sort(all(sa), cmp);",
      "            tmp[sa[0]] = 0;",
      "            for (int i = 1; i < n; i++)",
      "                tmp[sa[i]] = tmp[sa[i-1]] + cmp(sa[i-1], sa[i]);",
      "            rank_ = tmp;",
      "            if (rank_[sa[n-1]] == n-1) break;",
      "        }",
      "        // Kasai's LCP",
      "        vi inv(n);",
      "        for (int i = 0; i < n; i++) inv[sa[i]] = i;",
      "        int h = 0;",
      "        for (int i = 0; i < n; i++) {",
      "            if (inv[i] > 0) {",
      "                int j = sa[inv[i]-1];",
      "                while (i+h < n && j+h < n && s[i+h] == s[j+h]) h++;",
      "                lcp[inv[i]] = h;",
      "                if (h) h--;",
      "            }",
      "        }",
      "    }",
      "};"
    ],
    "description": "Suffix Array + LCP Array (O(n log n))"
  },
  "AhoCorasick": {
    "prefix": "aho",
    "body": [
      "// Aho-Corasick: multi-pattern string matching",
      "struct AhoCorasick {",
      "    struct Node {",
      "        int ch[26], fail, cnt;",
      "        Node() : fail(0), cnt(0) { fill(ch, ch+26, 0); }",
      "    };",
      "    vector<Node> t;",
      "    AhoCorasick() { t.emplace_back(); }",
      "",
      "    void insert(const string& s) {",
      "        int cur = 0;",
      "        for (char c : s) {",
      "            int x = c - 'a';",
      "            if (!t[cur].ch[x]) { t[cur].ch[x] = t.size(); t.emplace_back(); }",
      "            cur = t[cur].ch[x];",
      "        }",
      "        t[cur].cnt++;",
      "    }",
      "",
      "    void build() {",
      "        queue<int> q;",
      "        for (int c = 0; c < 26; c++)",
      "            if (t[0].ch[c]) q.push(t[0].ch[c]);",
      "        while (!q.empty()) {",
      "            int u = q.front(); q.pop();",
      "            t[u].cnt += t[t[u].fail].cnt; // accumulate",
      "            for (int c = 0; c < 26; c++) {",
      "                int v = t[u].ch[c];",
      "                if (v) { t[v].fail = t[t[u].fail].ch[c]; q.push(v); }",
      "                else t[u].ch[c] = t[t[u].fail].ch[c];",
      "            }",
      "        }",
      "    }",
      "",
      "    // Count total pattern occurrences in text",
      "    ll search(const string& s) {",
      "        ll res = 0; int cur = 0;",
      "        for (char c : s) {",
      "            cur = t[cur].ch[c - 'a'];",
      "            res += t[cur].cnt;",
      "        }",
      "        return res;",
      "    }",
      "};"
    ],
    "description": "Aho-Corasick automaton"
  },
  // ═══════════════════════════════════════════════════
  //  DYNAMIC PROGRAMMING (additions)
  // ═══════════════════════════════════════════════════
  "ConvexHullTrick": {
    "prefix": "cht",
    "body": [
      "// Convex Hull Trick (monotone — slopes must be added in decreasing order,",
      "// queries must be in increasing order for minimum)",
      "struct CHT {",
      "    struct Line { ll m, b; ll eval(ll x) { return m*x + b; } };",
      "    deque<Line> hull;",
      "",
      "    bool bad(Line l1, Line l2, Line l3) {",
      "        // l2 is never the minimum",
      "        return (__int128)(l3.b-l1.b)*(l1.m-l2.m) <= (__int128)(l2.b-l1.b)*(l1.m-l3.m);",
      "    }",
      "",
      "    void add(ll m, ll b) { // add line y = m*x + b; slopes decreasing",
      "        Line l = {m, b};",
      "        while (hull.size() >= 2 && bad(hull[hull.size()-2], hull[hull.size()-1], l))",
      "            hull.pop_back();",
      "        hull.push_back(l);",
      "    }",
      "",
      "    ll query(ll x) { // queries in increasing order",
      "        while (hull.size() >= 2 && hull[0].eval(x) >= hull[1].eval(x))",
      "            hull.pop_front();",
      "        return hull[0].eval(x);",
      "    }",
      "};"
    ],
    "description": "Convex Hull Trick (monotone deque, min query)"
  },
  "LiChaoTree": {
    "prefix": "lichao",
    "body": [
      "// Li Chao Tree: min over a set of lines at any x in [LO, HI]",
      "// Add lines in any order, query any x",
      "const ll LO = ${1:-1e9}, HI = ${2:1e9};",
      "struct LiChaoTree {",
      "    struct Line { ll m, b; ll eval(ll x) { return m*x + b; } };",
      "    struct Node { Line line; int l, r; };",
      "    vector<Node> t;",
      "    const Line INF_LINE = {0, (ll)2e18};",
      "    LiChaoTree() { t.push_back({INF_LINE, 0, 0}); }",
      "",
      "    void add(int v, ll lo, ll hi, Line seg) {",
      "        ll mid = (lo + hi) / 2;",
      "        bool l_better = seg.eval(lo) < t[v].line.eval(lo);",
      "        bool m_better = seg.eval(mid) < t[v].line.eval(mid);",
      "        if (m_better) swap(t[v].line, seg);",
      "        if (lo == hi) return;",
      "        if (l_better != m_better) {",
      "            if (!t[v].l) { t.push_back({INF_LINE,0,0}); t[v].l = t.size()-1; }",
      "            add(t[v].l, lo, mid, seg);",
      "        } else {",
      "            if (!t[v].r) { t.push_back({INF_LINE,0,0}); t[v].r = t.size()-1; }",
      "            add(t[v].r, mid+1, hi, seg);",
      "        }",
      "    }",
      "",
      "    ll query(int v, ll lo, ll hi, ll x) {",
      "        ll res = t[v].line.eval(x);",
      "        if (lo == hi) return res;",
      "        ll mid = (lo + hi) / 2;",
      "        if (x <= mid && t[v].l) return min(res, query(t[v].l, lo, mid, x));",
      "        if (x > mid && t[v].r) return min(res, query(t[v].r, mid+1, hi, x));",
      "        return res;",
      "    }",
      "",
      "    void add(ll m, ll b) { add(0, LO, HI, {m, b}); }",
      "    ll query(ll x) { return query(0, LO, HI, x); }",
      "};"
    ],
    "description": "Li Chao Tree (arbitrary lines, min query)"
  },
  "SpragueGrundy": {
    "prefix": "grundy",
    "body": [
      "// Sprague-Grundy theorem: compute Grundy values (nimbers)",
      "// grundy[state] = mex of {grundy[next_state] for all moves}",
      "// XOR of all grundy values == 0 → second player wins",
      "vi grundy(MAXN, -1);",
      "",
      "function<int(int)> mex_grundy = [&](int state) -> int {",
      "    if (grundy[state] != -1) return grundy[state];",
      "    set<int> reachable;",
      "    for (int next : get_moves(state)) // define get_moves",
      "        reachable.insert(mex_grundy(next));",
      "    int mex = 0;",
      "    while (reachable.count(mex)) mex++;",
      "    return grundy[state] = mex;",
      "};"
    ],
    "description": "Sprague-Grundy / Nimber computation"
  },
  // ═══════════════════════════════════════════════════
  //  MISCELLANEOUS (additions)
