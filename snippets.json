  "MatVecMul": {
    "prefix": "matvec",
    "body": [
      "// Multiply matrix A (n x n) by column vector v (n x 1)",
      "vector<ll> mat_vec(const Matrix& A, const vector<ll>& v) {",
      "    int n = A.size();",
      "    vector<ll> res(n, 0);",
      "    for (int i = 0; i < n; i++)",
      "        for (int j = 0; j < n; j++)",
      "            res[i] = (res[i] + A[i][j] * v[j]) % MOD;",
      "    return res;",
      "}"
    ],
    "description": "Matrix × vector multiply (use with matexp for linear recurrences)"
  },
  "LinearRecurrence": {
    "prefix": "linrec",
    "body": [
      "// Compute f(n) for linear recurrence f(n) = c[0]*f(n-1) + ... + c[k-1]*f(n-k)",
      "// base[0..k-1] = f(0)..f(k-1), c[0..k-1] are coefficients",
      "// Build companion matrix and raise to power n",
      "// [[c0,c1,...,ck-1], [1,0,...,0], [0,1,...,0], ...]",
      "ll linear_rec(vector<ll> base, vector<ll> c, ll n) {",
      "    int k = c.size();",
      "    if (n < k) return base[n];",
      "    Matrix A(k, vector<ll>(k, 0));",
      "    for (int j = 0; j < k; j++) A[0][j] = c[j];",
      "    for (int i = 1; i < k; i++) A[i][i-1] = 1;",
      "    Matrix R = mat_pow(A, n - k + 1);",
      "    vector<ll> v(base.rbegin(), base.rend()); // v[0] = f(k-1)",
      "    vector<ll> res = mat_vec(R, v);",
      "    return res[0];",
      "}"
    ],
    "description": "General linear recurrence via matrix exponentiation"
  },
  "SPFSieve": {
