  "MeetInMiddle": {
    "prefix": "mitm",
    "body": [
      "// Meet in the Middle — split array a[0..n-1] into two halves",
      "int half = n / 2;",
      "vector<ll> left_sums, right_sums;",
      "",
      "// enumerate all 2^half subsets of left half",
      "for (int mask = 0; mask < (1 << half); mask++) {",
      "    ll s = 0;",
      "    for (int i = 0; i < half; i++)",
      "        if (mask >> i & 1) s += a[i];",
      "    left_sums.push_back(s);",
      "}",
      "// enumerate all 2^(n-half) subsets of right half",
      "for (int mask = 0; mask < (1 << (n - half)); mask++) {",
      "    ll s = 0;",
      "    for (int i = 0; i < n - half; i++)",
      "        if (mask >> i & 1) s += a[half + i];",
      "    right_sums.push_back(s);",
      "}",
      "sort(all(right_sums));",
      "// example: count pairs summing to target",
      "ll ans = 0;",
      "for (ll x : left_sums) {",
      "    ll need = ${1:target} - x;",
      "    ans += upper_bound(all(right_sums), need) - lower_bound(all(right_sums), need);",
