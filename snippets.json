  "Compress": {
    "prefix": "compressmap",
    "body": [
      "// Coordinate compression using a map (handles negative/large values)",
      "map<int,int> comp;",
      "// collect all values into a set, then assign compressed ids",
      "set<int> vals(all(a));",
      "int idx = 0;",
      "for (int x : vals) comp[x] = idx++;",
      "// now comp[a[i]] gives 0-indexed compressed value"
    ],
    "description": "Coordinate compression (map-based, handles negatives)"
  },
  "LongestCommonSubsequence": {
    "prefix": "lcs",
    "body": [
      "// LCS length of strings/arrays a and b — O(n*m)",
      "int na = a.size(), nb = b.size();",
      "vector<vi> dp(na+1, vi(nb+1, 0));",
      "for (int i = 1; i <= na; i++)",
      "    for (int j = 1; j <= nb; j++)",
      "        dp[i][j] = (a[i-1] == b[j-1]) ? dp[i-1][j-1]+1",
      "                                        : max(dp[i-1][j], dp[i][j-1]);",
      "int lcs_len = dp[na][nb];"
    ],
    "description": "Longest Common Subsequence"
  },
  "EditDistance": {
    "prefix": "editdist",
    "body": [
      "// Edit distance (Levenshtein) between strings s and t",
      "int ns = s.size(), nt = t.size();",
      "vector<vi> dp(ns+1, vi(nt+1, 0));",
      "for (int i = 0; i <= ns; i++) dp[i][0] = i;",
      "for (int j = 0; j <= nt; j++) dp[0][j] = j;",
      "for (int i = 1; i <= ns; i++)",
      "    for (int j = 1; j <= nt; j++)",
      "        dp[i][j] = s[i-1]==t[j-1] ? dp[i-1][j-1]",
      "                                   : 1 + min({dp[i-1][j], dp[i][j-1], dp[i-1][j-1]});",
      "int ans = dp[ns][nt];"
    ],
    "description": "Edit Distance (Levenshtein)"
  },
  "FastRead": {
    "prefix": "fastread",
    "body": [
      "// Fast integer reader (faster than cin for large inputs)",
      "inline ll readll() {",
      "    ll x = 0; int c = getchar_unlocked(); bool neg = false;",
      "    while (c != '-' && (c < '0' || c > '9')) c = getchar_unlocked();",
      "    if (c == '-') { neg = true; c = getchar_unlocked(); }",
      "    while (c >= '0' && c <= '9') { x = x*10 + c-'0'; c = getchar_unlocked(); }",
      "    return neg ? -x : x;",
      "}"
    ],
    "description": "Fast integer reader (getchar_unlocked)"
  },
