  "Discretize": {
    "prefix": "discretize",
    "body": [
      "// Replace values in array a with their 1-indexed sorted rank",
      "vi sorted_a = a;",
      "sort(all(sorted_a)); sorted_a.erase(unique(all(sorted_a)), sorted_a.end());",
      "for (int& x : a)",
      "    x = lower_bound(all(sorted_a), x) - sorted_a.begin() + 1;",
      "// sorted_a[x-1] recovers original value"
    ],
    "description": "Discretize (in-place rank assignment)"
  },
  "EulerPhiSieve": {
    "prefix": "phisieve",
    "body": [
      "// Euler phi sieve — compute phi[i] for all i in [1, MAXN)",
      "vi phi(MAXN);",
      "iota(all(phi), 0);",
      "for (int i = 2; i < MAXN; i++) {",
      "    if (phi[i] == i) { // i is prime",
      "        for (int j = i; j < MAXN; j += i)",
      "            phi[j] -= phi[j] / i;",
      "    }",
      "}"
    ],
    "description": "Euler Totient Sieve (all phi values up to MAXN)"
  },
  "PointInPolygon": {
    "prefix": "pip",
    "body": [
      "// Point in polygon (ray casting) — 1: inside, 0: outside, -1: on boundary",
      "int point_in_polygon(vector<Point>& poly, Point p) {",
      "    int n = poly.size(), cnt = 0;",
      "    for (int i = 0; i < n; i++) {",
      "        Point a = poly[i] - p, b = poly[(i+1)%n] - p;",
      "        if (fabsl(a.cross(b)) < 1e-9 && a.dot(b) <= 1e-9) return -1; // on edge",
      "        if (a.y > b.y) swap(a, b);",
      "        if (a.y < 0 && b.y >= 0 && a.cross(b) > 0) cnt++;",
      "    }",
      "    return cnt & 1;",
      "}"
    ],
    "description": "Point in Polygon (ray casting)"
  },
  "SegmentIntersect": {
    "prefix": "segintersect",
    "body": [
      "// Do segments (p1,p2) and (p3,p4) intersect?",
      "bool on_segment(Point p, Point a, Point b) {",
      "    return fabsl((a-p).cross(b-p)) < 1e-9 && (a-p).dot(b-p) <= 1e-9;",
      "}",
      "bool segments_intersect(Point p1, Point p2, Point p3, Point p4) {",
      "    ld d1 = (p2-p1).cross(p3-p1), d2 = (p2-p1).cross(p4-p1);",
      "    ld d3 = (p4-p3).cross(p1-p3), d4 = (p4-p3).cross(p2-p3);",
      "    if (((d1>0&&d2<0)||(d1<0&&d2>0)) && ((d3>0&&d4<0)||(d3<0&&d4>0))) return true;",
      "    if (fabsl(d1)<1e-9 && on_segment(p3,p1,p2)) return true;",
      "    if (fabsl(d2)<1e-9 && on_segment(p4,p1,p2)) return true;",
      "    if (fabsl(d3)<1e-9 && on_segment(p1,p3,p4)) return true;",
      "    if (fabsl(d4)<1e-9 && on_segment(p2,p3,p4)) return true;",
      "    return false;",
      "}"
    ],
    "description": "Segment Intersection (with collinear check)"
  },
  "BinLiftPathQuery": {
    "prefix": "blpq",
    "body": [
      "// agg[u][j] = aggregate of 2^j nodes: u, parent(u), ..., (2^j - 1 steps up)",
      "// Lifting by 2^j: collect agg[u][j], THEN u = up[u][j]  (new u not yet included)",
      "struct BinLift {",
      "    int n;",
      "    static const int LOG = 20;",
      "    vi depth;",
      "    vector<vi>  up;",
      "    vll val;",
      "    vector<vll> amn, amx, agcd, asum;",
      "",
      "    void build(int _n, vll& v, vector<vi>& adj, int root = 1) {",
      "        n = _n; val = v;",
      "        depth.assign(n+1, 0);",
      "        up.assign  (n+1, vi (LOG, root));",
      "        amn.assign (n+1, vll(LOG,  INF));",
      "        amx.assign (n+1, vll(LOG, -INF));",
      "        agcd.assign(n+1, vll(LOG,    0));",
      "        asum.assign(n+1, vll(LOG,    0));",
      "        dfs(root, 0, adj);",
      "    }",
      "",
      "    void dfs(int u, int p, vector<vi>& adj) {",
      "        up[u][0] = p ? p : u;",
      "        amn[u][0] = amx[u][0] = agcd[u][0] = asum[u][0] = val[u];",
      "        for (int j = 1; j < LOG; j++) {",
      "            int a      = up[u][j-1];",
      "            up[u][j]   = up[a][j-1];",
      "            amn[u][j]  = min  (amn[u][j-1],  amn[a][j-1]);",
      "            amx[u][j]  = max  (amx[u][j-1],  amx[a][j-1]);",
      "            agcd[u][j] = __gcd(agcd[u][j-1], agcd[a][j-1]);",
      "            asum[u][j] = asum[u][j-1] + asum[a][j-1];",
      "        }",
      "        for (int v : adj[u]) if (v != p) { depth[v] = depth[u]+1; dfs(v, u, adj); }",
      "    }",
      "",
      "    int lca(int u, int v) {",
      "        if (depth[u] < depth[v]) swap(u, v);",
      "        int diff = depth[u] - depth[v];",
      "        for (int j = 0; j < LOG; j++) if (diff >> j & 1) u = up[u][j];",
      "        if (u == v) return u;",
      "        for (int j = LOG-1; j >= 0; j--) if (up[u][j] != up[v][j]) { u = up[u][j]; v = up[v][j]; }",
      "        return up[u][0];",
      "    }",
      "",
      "    // k=0 -> u itself, k=1 -> parent, ..., -1 if k > depth[u]",
      "    int kth_parent(int u, int k) {",
      "        if (k > depth[u]) return -1;",
      "        for (int j = 0; j < LOG; j++)",
      "            if (k >> j & 1) u = up[u][j];",
      "        return u;",
      "    }",
      "",
      "    ll qmin(int u, int v) {",
      "        ll ru = INF, rv = INF;",
      "        if (depth[u] < depth[v]) swap(u, v);",
      "        int diff = depth[u] - depth[v];",
      "        for (int j = 0; j < LOG; j++)",
      "            if (diff >> j & 1) { ru = min(ru, amn[u][j]); u = up[u][j]; }",
      "        if (u == v) return min(ru, val[u]);",
      "        for (int j = LOG-1; j >= 0; j--)",
      "            if (up[u][j] != up[v][j]) {",
      "                ru = min(ru, amn[u][j]); rv = min(rv, amn[v][j]);",
      "                u = up[u][j]; v = up[v][j];",
      "            }",
      "        return min({ru, rv, val[u], val[v], val[up[u][0]]});",
      "    }",
      "",
      "    ll qmax(int u, int v) {",
      "        ll ru = -INF, rv = -INF;",
      "        if (depth[u] < depth[v]) swap(u, v);",
      "        int diff = depth[u] - depth[v];",
      "        for (int j = 0; j < LOG; j++)",
      "            if (diff >> j & 1) { ru = max(ru, amx[u][j]); u = up[u][j]; }",
      "        if (u == v) return max(ru, val[u]);",
      "        for (int j = LOG-1; j >= 0; j--)",
      "            if (up[u][j] != up[v][j]) {",
      "                ru = max(ru, amx[u][j]); rv = max(rv, amx[v][j]);",
      "                u = up[u][j]; v = up[v][j];",
      "            }",
      "        return max({ru, rv, val[u], val[v], val[up[u][0]]});",
      "    }",
      "",
      "    ll qgcd(int u, int v) {",
      "        ll ru = 0, rv = 0;",
      "        if (depth[u] < depth[v]) swap(u, v);",
      "        int diff = depth[u] - depth[v];",
      "        for (int j = 0; j < LOG; j++)",
      "            if (diff >> j & 1) { ru = __gcd(ru, agcd[u][j]); u = up[u][j]; }",
      "        if (u == v) return __gcd(ru, val[u]);",
      "        for (int j = LOG-1; j >= 0; j--)",
      "            if (up[u][j] != up[v][j]) {",
      "                ru = __gcd(ru, agcd[u][j]); rv = __gcd(rv, agcd[v][j]);",
      "                u = up[u][j]; v = up[v][j];",
      "            }",
      "        return __gcd(__gcd(__gcd(__gcd(ru, rv), val[u]), val[v]), val[up[u][0]]);",
      "    }",
      "",
      "    ll qsum(int u, int v) {",
      "        ll ru = 0, rv = 0;",
      "        if (depth[u] < depth[v]) swap(u, v);",
      "        int diff = depth[u] - depth[v];",
      "        for (int j = 0; j < LOG; j++)",
      "            if (diff >> j & 1) { ru += asum[u][j]; u = up[u][j]; }",
      "        if (u == v) return ru + val[u];",
      "        for (int j = LOG-1; j >= 0; j--)",
      "            if (up[u][j] != up[v][j]) {",
      "                ru += asum[u][j]; rv += asum[v][j];",
      "                u = up[u][j]; v = up[v][j];",
      "            }",
      "        return ru + rv + val[u] + val[v] + val[up[u][0]];",
      "    }",
      "};",
      "",
      "// bl.build(n, vals, adj)   — root=1 by default",
      "// bl.lca(u, v)             — LCA",
      "// bl.kth_parent(u, k)      — k-th ancestor (0=self, -1 if doesn't exist)",
      "// bl.qmin/qmax/qgcd/qsum   — path aggregate (inclusive both ends)"
    ],
    "description": "Binary Lifting: LCA + kth parent + path queries (min, max, gcd, sum)"
  },
  // ═══════════════════════════════════════════════════
  //  BITWISE — single-bit ops (macros)
  // ═══════════════════════════════════════════════════
  "BitMacros": {
    "prefix": "bitmacros",
    "body": [
      "#define getbit(x,i)   (((x) >> (i)) & 1LL)         // value of bit i (0 / 1)",
      "#define setbit(x,i)   ((x) |=  (1LL << (i)))        // force bit i = 1",
      "#define clrbit(x,i)   ((x) &= ~(1LL << (i)))        // force bit i = 0",
      "#define flipbit(x,i)  ((x) ^=  (1LL << (i)))        // toggle bit i",
      "#define ison(x,i)     (((x) >> (i)) & 1LL)          // is bit i set?",
      "#define lowmask(k)    ((1LL << (k)) - 1)            // mask with lowest k bits set",
      "#define rngmask(l,r)  (lowmask((r)+1) ^ lowmask(l)) // bits [l..r] set (inclusive)"
    ],
    "description": "Single-bit manipulation macros (get / set / clear / flip / range mask)"
  },
  "BitBuiltins": {
    "prefix": "bitbuiltins",
    "body": [
      "// GCC built-ins — use the 'll' suffix for 64-bit / long long:",
      "//   __builtin_popcountll(x) — number of set bits",
      "//   __builtin_ctzll(x)      — trailing zeros = index of lowest set bit  (x != 0)",
      "//   __builtin_clzll(x)      — leading  zeros (x != 0); msb index = 63 - clz",
      "//   __builtin_parityll(x)   — parity of set bits (popcount & 1)",
      "//   __builtin_ffsll(x)      — 1 + index of lowest set bit, 0 if x == 0",
      "//   __lg(x)                 — floor(log2 x) = index of highest set bit (x >= 1)",
      "int LSB   = __builtin_ctzll(x);        // lowest set bit index   (x != 0)",
      "int MSB   = 63 - __builtin_clzll(x);   // highest set bit index  (== __lg(x))",
      "int NBITS = x ? __lg(x) + 1 : 0;       // bits needed to represent x"
    ],
    "description": "GCC bit built-in cheatsheet + common derived indices"
  },
  "BitTricks": {
    "prefix": "bittricks",
    "body": [
      "// x & -x          -> isolate lowest set bit (its value = a power of two)",
      "// x & (x - 1)     -> clear lowest set bit",
      "// x | (x + 1)     -> set lowest unset bit",
      "// ~x & (x + 1)    -> isolate lowest unset bit",
      "// x & (x + 1)     -> clear trailing 1s",
      "// x | (x - 1)     -> set trailing 0s",
      "// (x ^ y) < 0     -> x and y have opposite signs (signed)",
      "// x && !(x&(x-1)) -> x is a power of two  (x > 0)"
    ],
    "description": "Common bit-trick idioms (reference)"
  },
  "IterateSetBits": {
    "prefix": "setbits",
    "body": [
      "// Iterate indices of set bits in x (lowest first)",
      "for (ll m = x; m; m &= m - 1) {",
      "    int b = __builtin_ctzll(m);  // current set-bit index",
      "    // use b",
      "}"
    ],
    "description": "Iterate set-bit indices of a mask"
  },
  // ═══════════════════════════════════════════════════
  //  BITWISE — powers of two
  // ═══════════════════════════════════════════════════
  "PowerOfTwo": {
    "prefix": "pow2",
    "body": [
      "bool is_pow2(ll x) { return x > 0 && (x & (x - 1)) == 0; }",
      "// largest power of two <= x  (requires x >= 1)",
      "ll floor_pow2(ll x) { return 1LL << __lg(x); }",
      "// smallest power of two >= x  (requires x >= 1)",
      "ll ceil_pow2(ll x) { return is_pow2(x) ? x : (1LL << (__lg(x) + 1)); }"
    ],
    "description": "Power-of-two checks and rounding"
  },
  // ═══════════════════════════════════════════════════
  //  BITWISE — conversions
  // ═══════════════════════════════════════════════════
  "ToBinary": {
    "prefix": "tobin",
    "body": [
      "// Binary string of x (MSB first). width = 0 -> minimal length.",
      "string to_binary(ll x, int width = 0) {",
      "    string s;",
      "    if (x == 0) s = \"0\";",
      "    while (x > 0) { s += char('0' + (x & 1)); x >>= 1; }",
      "    reverse(all(s));",
      "    while ((int)s.size() < width) s = \"0\" + s;",
      "    return s;",
      "}",
      "// Fixed-width alt: bitset<32>(x).to_string()  /  bitset<64>(x).to_string()"
    ],
    "description": "Integer -> binary string (optional fixed width)"
  },
  "FromBinary": {
    "prefix": "frombin",
    "body": [
      "// Binary string (MSB first) -> integer",
      "ll from_binary(const string& s) {",
      "    ll x = 0;",
      "    for (char c : s) x = (x << 1) | (c - '0');",
      "    return x;",
      "}",
      "// stdlib equivalent: stoll(s, nullptr, 2)"
    ],
    "description": "Binary string -> integer"
  },
  "BitsToVector": {
    "prefix": "bitsvec",
    "body": [
      "// x -> vector of n bits, b[i] = bit i  (LSB at index 0)",
      "vi to_bits(ll x, int n) {",
      "    vi b(n);",
      "    for (int i = 0; i < n; i++) b[i] = (x >> i) & 1;",
      "    return b;",
      "}",
      "// vector of bits (b[i] = bit i, LSB first) -> integer",
      "ll from_bits(const vi& b) {",
      "    ll x = 0;",
      "    for (int i = 0; i < (int)b.size(); i++) if (b[i]) x |= 1LL << i;",
      "    return x;",
      "}"
    ],
    "description": "Integer <-> bit vector (LSB-first)"
  },
  "PrintBinary": {
    "prefix": "printbin",
    "body": [
      "// Print x as a width-bit binary string (MSB first)",
      "auto print_bin = [&](ll x, int width) {",
      "    for (int i = width - 1; i >= 0; i--) cout << ((x >> i) & 1);",
      "    cout << \"\\n\";",
      "};"
    ],
    "description": "Print integer as fixed-width binary"
  },
  // ═══════════════════════════════════════════════════
  //  BITWISE — subset / superset enumeration
  // ═══════════════════════════════════════════════════
  "GosperHack": {
    "prefix": "gosper",
    "body": [
      "// Iterate all k-element subsets of an n-bit universe (Gosper's hack)",
      "// Also: 'next integer with the same popcount' (snoob)",
      "int c = (1 << k) - 1;",
      "while (c < (1 << n)) {",
      "    // process subset c  (popcount(c) == k)",
      "    int lo = c & -c;",
      "    int hi = c + lo;",
      "    c = (((c ^ hi) >> 2) / lo) | hi;",
      "}"
    ],
    "description": "Gosper's hack — enumerate all k-subsets of n bits"
  },
  "IterateSupersets": {
    "prefix": "supersets",
    "body": [
      "// Iterate all supersets of 'mask' within an n-bit universe",
      "for (int sup = mask; sup < (1 << n); sup = (sup + 1) | mask) {",
      "    // process sup  (mask subset of sup)",
      "}"
    ],
    "description": "Enumerate all supersets of a mask"
  },
  // ═══════════════════════════════════════════════════
  //  BITWISE — gray code, reversal, branchless
  // ═══════════════════════════════════════════════════
  "GrayCode": {
    "prefix": "gray",
    "body": [
      "// Gray code: consecutive values differ in exactly one bit",
      "ll gray(ll n)     { return n ^ (n >> 1); }                          // n -> gray(n)",
      "ll inv_gray(ll g) { ll n = 0; for (; g; g >>= 1) n ^= g; return n; } // gray -> n"
    ],
    "description": "Gray code encode / decode"
  },
  "ReverseBits": {
    "prefix": "bitrev",
    "body": [
      "// Reverse the low 'bits' bits of x",
      "ll reverse_bits(ll x, int bits) {",
      "    ll r = 0;",
      "    for (int i = 0; i < bits; i++)",
      "        if ((x >> i) & 1) r |= 1LL << (bits - 1 - i);",
      "    return r;",
      "}"
    ],
    "description": "Reverse the lowest 'bits' bits of an integer"
  },
  "Branchless": {
    "prefix": "branchless",
    "body": [
      "// Branchless tricks (signed 64-bit)",
      "auto xor_swap = [](ll& a, ll& b) { if (&a != &b) { a ^= b; b ^= a; a ^= b; } };",
      "auto abs64    = [](ll x) { ll m = x >> 63; return (x ^ m) - m; };",
      "auto min64    = [](ll a, ll b) { return b ^ ((a ^ b) & -(a < b)); };",
      "auto max64    = [](ll a, ll b) { return a ^ ((a ^ b) & -(a < b)); };",
      "// opposite signs:  ((a ^ b) < 0)"
    ],
    "description": "Branchless swap / abs / min / max"
  },
  // ═══════════════════════════════════════════════════
  //  BITWISE — std::bitset
  // ═══════════════════════════════════════════════════
  "BitsetOps": {
    "prefix": "bitset",
    "body": [
      "bitset<${1:N}> bs;            // all zeros, fixed COMPILE-TIME size",
      "// bs.set()           -> all bits 1",
      "// bs.set(i)          -> bit i = 1      bs.reset(i) -> bit i = 0",
      "// bs.flip()/flip(i)  -> toggle",
      "// bs[i]              -> access (bool)",
      "// bs.count()         -> number of set bits",
      "// bs.any()/none()/all()",
      "// bs._Find_first()   -> index of lowest set bit (== size() if none)",
      "// bs._Find_next(i)   -> index of next set bit after i",
      "// bs.to_ullong()     -> unsigned long long",
      "// bs.to_string()     -> binary string (MSB first)",
      "// supports & | ^ ~ << >> between same-size bitsets"
    ],
    "description": "std::bitset common operations cheatsheet"
  },
  "ToBinary64": {
    "prefix": "tobin64",
    "body": [
      "// All 64 bits of x (MSB first), leading zeros included",
      "string to_binary64(ll x) {",
      "    string s(64, '0');",
      "    unsigned long long u = (unsigned long long)x;",
      "    for (int i = 0; i < 64; i++)",
      "        if (u >> i & 1) s[63 - i] = '1';",
      "    return s;",
      "}"
    ],
    "description": "Integer -> full 64-bit binary string (all bits, MSB first)"
  },
  // ═══════════════════════════════════════════════════
  //  TREE FUNDAMENTALS
  //  (merge these entries into your existing snippets file)
  // ═══════════════════════════════════════════════════
  "TreeRootedBasics": {
    "prefix": "treeinit",
    "body": [
      "// Root the tree: parent, depth, subtree size — one DFS",
      "vi par(n + 1, 0), depth(n + 1, 0), sz(n + 1, 1);",
      "",
      "function<void(int,int)> dfs = [&](int u, int p) {",
      "    par[u] = p;",
      "    for (int v : adj[u]) {",
      "        if (v == p) continue;",
      "        depth[v] = depth[u] + 1;",
      "        dfs(v, u);",
      "        sz[u] += sz[v];",
      "    }",
      "};",
      "dfs(${1:1}, 0);"
    ],
    "description": "Rooted tree basics: parent[], depth[], subtree size[]"
  },
  "TreeDepthBFS": {
    "prefix": "treedepthbfs",
    "body": [
      "// Parent + depth via BFS (no recursion — safe for n up to 1e6+)",
      "vi par(n + 1, 0), depth(n + 1, 0);",
      "queue<int> q;",
      "q.push(${1:1});",
      "par[${1:1}] = 0;",
      "vi visited(n + 1, 0);",
      "visited[${1:1}] = 1;",
      "while (!q.empty()) {",
      "    int u = q.front(); q.pop();",
      "    for (int v : adj[u]) {",
      "        if (!visited[v]) {",
      "            visited[v] = 1;",
      "            par[v] = u;",
      "            depth[v] = depth[u] + 1;",
      "            q.push(v);",
      "        }",
      "    }",
      "}"
    ],
    "description": "Tree parent + depth via BFS (recursion-free)"
  },
  "SubtreeSum": {
    "prefix": "subtreesum",
    "body": [
      "// val[u] = value at node u (1-indexed)",
      "// sub[u] = sum of val over the subtree rooted at u",
      "vll sub(n + 1, 0);",
      "",
      "function<void(int,int)> dfs = [&](int u, int p) {",
      "    sub[u] = val[u];",
      "    for (int v : adj[u]) {",
      "        if (v == p) continue;",
      "        dfs(v, u);",
      "        sub[u] += sub[v];",
      "    }",
      "};",
      "dfs(${1:1}, 0);"
    ],
    "description": "Subtree sum of node values"
  },
  "SubtreeAggregates": {
    "prefix": "subtreeagg",
    "body": [
      "// Per-node subtree aggregates over node values val[u]:",
      "// sz, sum, min, max (all include u itself)",
      "vi sz(n + 1, 1);",
      "vll sub_sum(n + 1, 0), sub_min(n + 1, INF), sub_max(n + 1, -INF);",
      "",
      "function<void(int,int)> dfs = [&](int u, int p) {",
      "    sub_sum[u] = val[u];",
      "    sub_min[u] = val[u];",
      "    sub_max[u] = val[u];",
      "    for (int v : adj[u]) {",
      "        if (v == p) continue;",
      "        dfs(v, u);",
      "        sz[u]      += sz[v];",
      "        sub_sum[u] += sub_sum[v];",
      "        sub_min[u]  = min(sub_min[u], sub_min[v]);",
      "        sub_max[u]  = max(sub_max[u], sub_max[v]);",
      "    }",
      "};",
      "dfs(${1:1}, 0);"
    ],
    "description": "Subtree size, sum, min, max in one DFS"
  },
  "TreeHeight": {
    "prefix": "treeheight",
    "body": [
      "// height[u] = length (in edges) of longest downward path from u",
      "// height[leaf] = 0",
      "vi height(n + 1, 0);",
      "",
      "function<void(int,int)> dfs = [&](int u, int p) {",
      "    for (int v : adj[u]) {",
      "        if (v == p) continue;",
      "        dfs(v, u);",
      "        height[u] = max(height[u], height[v] + 1);",
      "    }",
      "};",
      "dfs(${1:1}, 0);"
    ],
    "description": "Height of every node (longest downward path)"
  },
  "TreeIterativeDFS": {
    "prefix": "dfsiter",
    "body": [
      "// Iterative DFS — avoids stack overflow on deep trees (n up to ~1e6)",
      "// Pass 1 builds preorder; reverse preorder is a valid post-order,",
      "// so subtree aggregates can be computed in a plain loop.",
      "vi par(n + 1, 0), depth(n + 1, 0), order;",
      "order.reserve(n);",
      "vi stk = {${1:1}};",
      "par[${1:1}] = 0;",
      "while (!stk.empty()) {",
      "    int u = stk.back(); stk.pop_back();",
      "    order.push_back(u);",
      "    for (int v : adj[u]) {",
      "        if (v == par[u]) continue;",
      "        par[v] = u;",
      "        depth[v] = depth[u] + 1;",
      "        stk.push_back(v);",
      "    }",
      "}",
      "",
      "// Subtree aggregates in reverse preorder (children before parents)",
      "vi sz(n + 1, 1);",
      "vll sub(n + 1, 0);",
      "for (int i = n - 1; i >= 0; i--) {",
      "    int u = order[i];",
      "    sub[u] += val[u];",
      "    if (par[u]) {",
      "        sz[par[u]]  += sz[u];",
      "        sub[par[u]] += sub[u];",
      "    }",
      "}"
    ],
    "description": "Iterative tree DFS + subtree aggregates (no recursion)"
  },
  "FlattenTree": {
    "prefix": "flatten",
    "body": [
      "// Flatten tree: subtree of u = contiguous range [tin[u], tin[u]+sz[u]-1]",
      "// Pair with Fenwick/SegTree over flat[] for subtree queries + point updates",
      "vi tin(n + 1), sz(n + 1, 1);",
      "vll flat(n); // flat[tin[u]] = val[u]",
      "int timer = 0;",
      "",
      "function<void(int,int)> dfs = [&](int u, int p) {",
      "    tin[u] = timer++;",
      "    flat[tin[u]] = val[u];",
      "    for (int v : adj[u]) {",
      "        if (v == p) continue;",
      "        dfs(v, u);",
      "        sz[u] += sz[v];",
      "    }",
      "};",
      "dfs(${1:1}, 0);",
      "",
      "// subtree query on u  -> range [tin[u], tin[u] + sz[u] - 1] in flat[]",
      "// point update node u -> position tin[u]"
    ],
    "description": "Flatten tree (subtree = contiguous range) for SegTree/Fenwick"
  },
  "TreeDiameter": {
    "prefix": "treediameter",
    "body": [
      "// Tree diameter (unweighted) — double BFS",
      "// Endpoints of the diameter are a and b; length = d (edges)",
      "auto bfs_far = [&](int src) -> pii {",
      "    vi dist(n + 1, -1);",
      "    queue<int> q;",
      "    dist[src] = 0; q.push(src);",
      "    int far = src;",
      "    while (!q.empty()) {",
      "        int u = q.front(); q.pop();",
      "        if (dist[u] > dist[far]) far = u;",
      "        for (int v : adj[u]) {",
      "            if (dist[v] == -1) { dist[v] = dist[u] + 1; q.push(v); }",
      "        }",
      "    }",
      "    return {far, dist[far]};",
      "};",
      "auto [a, _] = bfs_far(1);",
      "auto [b, d] = bfs_far(a);",
      "// d = diameter length, path runs between a and b"
    ],
    "description": "Tree diameter (double BFS, unweighted)"
  },
  "TreeDiameterWeighted": {
    "prefix": "wdiameter",
    "body": [
      "// Weighted diameter / max path via DP — adj[u] = {v, w}",
      "// Handles negative weights too (best path of >= 1 node)",
      "ll best = -INF;",
      "",
      "function<ll(int,int)> dfs = [&](int u, int p) -> ll {",
      "    ll top1 = 0, top2 = 0; // two best downward chains from u",
      "    for (auto [v, w] : adj[u]) {",
      "        if (v == p) continue;",
      "        ll d = max(0LL, dfs(v, u) + w); // drop negative chains",
      "        if (d > top1) { top2 = top1; top1 = d; }",
      "        else if (d > top2) top2 = d;",
      "    }",
      "    best = max(best, top1 + top2);",
      "    return top1;",
      "};",
      "dfs(${1:1}, 0);"
    ],
    "description": "Weighted tree diameter / max path sum (DP)"
  },
  "TreeDistance": {
    "prefix": "treedist",
    "body": [
      "// Distance between u and v in edges — requires depth[] and lca() (see lca snippet)",
      "auto tree_dist = [&](int u, int v) {",
      "    return depth[u] + depth[v] - 2 * depth[lca(u, v)];",
      "};"
    ],
    "description": "Distance between two nodes (via LCA)"
  },
  "KthNodeOnPath": {
    "prefix": "kthonpath",
    "body": [
      "// k-th node on path u -> v (k = 0 gives u) — requires lca() and kth_parent()",
      "auto kth_on_path = [&](int u, int v, int k) -> int {",
      "    int w = lca(u, v);",
      "    int du = depth[u] - depth[w];",
      "    int dv = depth[v] - depth[w];",
      "    if (k > du + dv) return -1; // path too short",
      "    if (k <= du) return kth_parent(u, k);",
      "    return kth_parent(v, du + dv - k);",
      "};"
    ],
    "description": "k-th node on path u -> v (LCA + binary lifting)"
  },
  "TreeLeaves": {
    "prefix": "leaves",
    "body": [
      "// Leaves of a rooted tree (root = ${1:1}); handles n == 1",
      "vi leaves;",
      "for (int u = 1; u <= n; u++) {",
      "    if (u == ${1:1}) { if (adj[u].empty()) leaves.push_back(u); }",
      "    else if ((int)adj[u].size() == 1) leaves.push_back(u);",
      "}"
    ],
    "description": "Collect leaf nodes of a tree"
  },
  "NodesPerDepth": {
    "prefix": "depthcount",
    "body": [
      "// cnt[d] = number of nodes at depth d; requires depth[] (see treeinit)",
      "int max_depth = *max_element(depth.begin() + 1, depth.end());",
      "vi cnt(max_depth + 1, 0);",
      "for (int u = 1; u <= n; u++) cnt[depth[u]]++;"
    ],
    "description": "Count nodes at each depth level"
  },
  "PathToRoot": {
    "prefix": "rootpath",
    "body": [
      "// Path from u up to the root (inclusive); requires par[] with par[root] = 0",
      "vi path;",
      "for (int x = ${1:u}; x != 0; x = par[x]) path.push_back(x);",
      "// path = {u, par[u], ..., root}; reverse(all(path)) for root -> u"
    ],
    "description": "Path from node to root via parent array"
  },
  "ParentArrayToAdj": {
    "prefix": "parent2adj",
    "body": [
      "// Build adjacency / children lists from a parent array",
      "// Input format: p[i] = parent of node i, for i = 2..n (root = 1)",
      "vector<vi> adj(n + 1), children(n + 1);",
      "for (int i = 2; i <= n; i++) {",
      "    int p; cin >> p;",
      "    adj[p].push_back(i);",
      "    adj[i].push_back(p);",
      "    children[p].push_back(i);",
      "}"
    ],
    "description": "Parent array to adjacency list / children lists"
  },
  "TreeCenter": {
    "prefix": "treecenter",
    "body": [
      "// Tree center(s) — peel leaves layer by layer (1 or 2 centers)",
      "vi deg(n + 1);",
      "for (int u = 1; u <= n; u++) deg[u] = adj[u].size();",
      "queue<int> q;",
      "for (int u = 1; u <= n; u++) if (deg[u] <= 1) q.push(u);",
      "int remaining = n;",
      "vi centers;",
      "while (remaining > 2) {",
      "    int layer = q.size();",
      "    remaining -= layer;",
      "    while (layer--) {",
      "        int u = q.front(); q.pop();",
      "        for (int v : adj[u]) if (--deg[v] == 1) q.push(v);",
      "    }",
      "}",
      "while (!q.empty()) { centers.push_back(q.front()); q.pop(); }"
    ],
    "description": "Tree center(s) by leaf peeling"
  }
}
